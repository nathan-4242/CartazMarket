{
  "name": "@cartazmarket/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node --use-system-ca --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --use-system-ca --env-file=../../.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node --env-file=../../.env --import tsx scripts/migrate.ts",
    "test:expiry": "node --env-file=../../.env --import tsx scripts/test-expiry-routes.ts",
    "smoke:price-drops": "node --env-file=../../.env --import tsx scripts/smoke-price-drop-flow.ts"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.0.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
